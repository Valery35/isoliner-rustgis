{
  "id": "isoliner",
  "name": "Isoliner",
  "version": "0.1.0",
  "description": "Isoliner tools for RustGIS. They compute as in the Isoliner plugin for QGIS and take the same fields. Seven tools: 1.05, 1.06, 1.08, 1.09, 1.11, 4.13 and 7.03.",
  "author": "Inform++ LLC",
  "license": "Apache-2.0",
  "runtime": "process",
  "session": true,
  "run": { "windows": ["bin/isoliner-rustgis.exe", "rustgis-plugin"] },
  "minRustgisVersion": "0.5.0",
  "commands": [
    { "id": "about", "label": "About\nIsoliner", "help": "About the extension with its version and the number of tools.", "icon": "info", "params": "{} (answers the title, the version of the extension and of the QGIS plugin it follows, the number of tools)" }
  ],
  "tools": [
    {"id":"declustering","name":"1.05 Declustering (weights)","params":[{"kind":"pointLayer","label":"Points with values","name":"input","required":true},{"kind":"numericField","label":"Value field Z (empty = from the geometry)","name":"zfield"},{"choices":["Auto (size sweep)","Manual size"],"default":"Auto (size sweep)","kind":"choice","label":"Cell size","name":"mode"},{"default":0.0,"kind":"number","label":"Cell size for manual mode","name":"cell_size"},{"choices":["Minimum mean (clusters in the rich)","Maximum mean (clusters in the poor)"],"default":"Minimum mean (clusters in the rich)","kind":"choice","label":"Sweep objective","name":"objective"},{"default":24,"kind":"number","label":"Number of sizes in the sweep","name":"ncell"},{"default":1.0,"kind":"number","label":"Cell Y/X ratio","name":"aspect"},{"default":4,"kind":"number","label":"Grid-origin offsets (averaging)","name":"noff"}],"summary":"Cell declustering (a port of GSLIB declus).","toolbox":"Isoliner"},
    {"id":"geophysprofiles","name":"1.11 Example geophysical profiles (demo)","params":[{"help":"The profiles are laid out within the extent of the features of this layer.","kind":"vectorLayer","label":"Layer whose extent to build in","name":"extent","required":true},{"choices":["Electrical prospecting (rho_k, SP, IP)","Subsidence (trough)"],"default":"Electrical prospecting (rho_k, SP, IP)","kind":"choice","label":"Mode","name":"mode"},{"default":4,"kind":"number","label":"Number of profiles","name":"n_profiles"},{"default":20.0,"kind":"number","label":"Picket step, m","name":"picket_step"},{"default":60.0,"kind":"number","label":"Background rho_k, Ohm*m","name":"rho_bg"},{"default":10.0,"kind":"number","label":"Minimum rho_k in the anomaly, Ohm*m","name":"rho_min"},{"default":-100.0,"kind":"number","label":"SP anomaly amplitude, mV (usually < 0)","name":"sp_amp"},{"default":15.0,"kind":"number","label":"IP anomaly amplitude, mV/V","name":"vp_amp"},{"default":0.06,"kind":"number","label":"rho_k noise (fraction, log scale)","name":"noise"},{"default":400.0,"kind":"number","label":"Maximum subsidence (trough), mm","name":"subs_max"},{"default":120.0,"kind":"number","label":"Surface elevation: base, m","name":"z_base"},{"default":15.0,"kind":"number","label":"Surface elevation: amplitude, m","name":"z_amp"},{"default":2,"kind":"number","label":"Number of tours (for subsidence)","name":"n_tours"},{"choices":["Down (negative)","Magnitude (positive)"],"default":"Down (negative)","kind":"choice","label":"Subsidence sign","name":"subs_sign"},{"default":1,"kind":"number","label":"RNG seed (0 = random)","name":"seed"}],"summary":"Creates a point layer of geophysical profiles for learning and testing the tools without real data.","toolbox":"Isoliner"},
    {"id":"bed-grades-at-collars","name":"4.13 Bed grades at the collars","params":[{"kind":"pointLayer","label":"Collars (collar, points)","name":"collar","required":true},{"default":"hole_id","kind":"field","label":"Hole identifier field, collars","name":"cid"},{"kind":"layer","label":"Intervals along the hole (interval, table)","name":"interval","required":true},{"default":"hole_id","kind":"field","label":"Hole identifier field, intervals","name":"iid"},{"default":"from","kind":"field","label":"Interval top field (usually from)","name":"ifrom"},{"default":"to","kind":"field","label":"Interval bottom field (usually to)","name":"ito"},{"default":"code","kind":"field","label":"Bed code field (usually code)","name":"icode"},{"kind":"layer","label":"Assay samples (chem, table)","name":"chem","required":true},{"default":"hole_id","kind":"field","label":"Hole identifier field, samples","name":"hid"},{"default":"from","kind":"field","label":"Sample top field (usually from)","name":"hfrom"},{"default":"to","kind":"field","label":"Sample bottom field (usually to)","name":"hto"},{"default":[],"kind":"numericField","label":"Grade fields","name":"components"},{"kind":"text","label":"Bed code","name":"bed"},{"default":0.5,"kind":"number","label":"Smallest sample coverage of the bed, fraction","name":"min_cover"}],"summary":"Weighted-average grades of one bed, brought out to the points of the well collars.","toolbox":"Isoliner"},
    {"id":"line-dimension","name":"7.03 Dimension of lines and boundaries","params":[{"kind":"vectorLayer","label":"Lines or polygons","name":"lines","required":true}],"summary":"Computes the dimension of every line by the divider (Richardson) method: the line is walked with chords of a decreasing span, the slope of log N versus log r gives D.","toolbox":"Isoliner"},
    {"id":"experimental-variogram","name":"1.06 Variogram (experimental)","params":[{"kind":"pointLayer","label":"Points with values","name":"input","required":true},{"kind":"numericField","label":"Value field Z (empty = from the geometry)","name":"zfield"},{"kind":"field","label":"Grouping field (optional, e.g. survey type)","name":"group_field"},{"kind":"numericField","label":"Declustering weight field (from 1.05)","name":"weight_field"},{"default":2.0,"kind":"number","label":"Minimum points per group, % of sample (floor 30 points)","name":"min_group_pct"},{"default":15,"kind":"number","label":"Number of lags","name":"n_lags"},{"default":0.0,"kind":"number","label":"Maximum distance, in layer units (0 = half-diagonal)","name":"maxlag"},{"default":true,"kind":"bool","label":"Fit model (recommendation)","name":"fit"},{"choices":["Auto (best by R²)","Spherical","Exponential","Gaussian"],"default":"Auto (best by R²)","kind":"choice","label":"Model to fit","name":"fit_model"},{"default":false,"kind":"bool","label":"Robust estimator (Cressie-Hawkins)","name":"robust"},{"default":0.0,"kind":"number","label":"Outliers: clip percentile, % (0 = off)","name":"val_pct"},{"kind":"number","label":"Lower value bound (empty = none)","name":"val_min"},{"kind":"number","label":"Upper value bound (empty = none)","name":"val_max"},{"default":false,"kind":"bool","label":"Cap to bound (capping) instead of removing","name":"val_cap"},{"kind":"text","label":"Profile name for the table (empty = after the value field)","name":"save_profile"},{"kind":"bool","label":"Variogram model (new table)","name":"out_model"},{"kind":"bool","label":"Variogram table (lag, γ, number of pairs)","name":"output"}],"summary":"Builds an isotropic experimental semivariogram from points: the pair cloud is averaged over distance intervals (lags).","toolbox":"Isoliner"},
    {"id":"crossvalidation","name":"1.08 Variogram cross-validation","params":[{"kind":"pointLayer","label":"Points with values","name":"input","required":true},{"kind":"numericField","label":"Value field Z (empty = from the geometry)","name":"zfield"},{"kind":"field","label":"Well number field","name":"idfield"},{"kind":"numericField","label":"Declustering weight field (from 1.05)","name":"weight_field"},{"choices":["Ordinary (OK)","Simple (SK)"],"default":"Ordinary (OK)","kind":"choice","label":"Kriging type","name":"ktype"},{"default":0.0,"kind":"number","label":"Search radius (0 = whole sample)","name":"radius"},{"default":1,"kind":"number","label":"Min. number of points","name":"min_points"},{"default":24,"kind":"number","label":"Max. number of points","name":"max_points"},{"default":0.0,"kind":"number","label":"Mean for simple kriging","name":"skmean"},{"default":0.0,"kind":"number","label":"Nugget C0","name":"nugget"},{"choices":["Spherical","Exponential","Gaussian","Power"],"default":"Spherical","kind":"choice","label":"Structure 1 · model","name":"s1_model"},{"default":1.0,"kind":"number","label":"Structure 1 · sill/contribution C","name":"s1_sill"},{"default":0.0,"kind":"number","label":"Structure 1 · correlation range a (0=auto)","name":"s1_range"},{"default":0.0,"kind":"number","label":"Structure 1 · azimuth, °","name":"s1_azimuth"},{"default":1.0,"kind":"number","label":"Structure 1 · anisotropy (minor/major)","name":"s1_anis"},{"default":0.0,"kind":"number","label":"Outliers: clip percentile, % (0 = off)","name":"val_pct"},{"kind":"number","label":"Lower value bound (empty = none)","name":"val_min"},{"kind":"number","label":"Upper value bound (empty = none)","name":"val_max"},{"default":false,"kind":"bool","label":"Cap to bound (capping) instead of removing","name":"val_cap"},{"default":false,"kind":"bool","label":"Remove polynomial trend","name":"detrend"},{"choices":["1 (plane)","2 (quadratic)"],"default":"1 (plane)","help":"The regional trend is removed by least squares before kriging, the residuals are kriged, and the trend is added back to the estimate. Useful for seam marks and thicknesses with a general dip. For chemistry without a trend the effect is negligible. Degree 1 is usually enough, degree 2 can absorb part of the real structure into the trend, so watch the residual variogram.","kind":"choice","label":"Trend degree","name":"detrend_deg"},{"kind":"layer","label":"Variogram models (table)","name":"vg_table"},{"kind":"text","label":"Profile from the table (empty = the fields below)","name":"vg_name"},{"kind":"bool","label":"Residuals layer (points)","name":"output"}],"summary":"Leave-one-out cross-validation: each well is removed in turn, its value is predicted by kriging from the rest, and compared with the actual value.","toolbox":"Isoliner"},
    {"id":"method-crossvalidation","name":"1.09 Method cross-validation (LOO)","params":[{"kind":"pointLayer","label":"Points with values","name":"input","required":true},{"kind":"numericField","label":"Value field Z (empty = from the geometry)","name":"zfield"},{"kind":"field","label":"Well number field","name":"idfield"},{"kind":"numericField","label":"Declustering weight field (from 1.05)","name":"weight_field"},{"choices":["Kriging","Minimum curvature"],"default":"Kriging","kind":"choice","label":"Method","name":"method"},{"kind":"layer","label":"Variogram models (table)","name":"vg_table"},{"kind":"text","label":"Profile from the table (empty = defaults)","name":"vg_name"},{"default":0,"kind":"number","label":"Points to validate (0 = auto, min(N, 100))","name":"n_validate"},{"default":0.0,"kind":"number","label":"Exclusion buffer in X (0 = off)","name":"excl_x"},{"default":0.0,"kind":"number","label":"Exclusion buffer in Y (0 = off)","name":"excl_y"},{"choices":["Ordinary (OK)","Simple (SK)"],"default":"Ordinary (OK)","kind":"choice","label":"Kriging type","name":"ktype"},{"default":0.0,"kind":"number","label":"Search radius (0 = whole sample)","name":"radius"},{"default":1,"kind":"number","label":"Min. number of points","name":"min_points"},{"default":24,"kind":"number","label":"Max. number of points","name":"max_points"},{"default":0.0,"kind":"number","label":"Mean for simple kriging","name":"skmean"},{"default":0.0,"kind":"number","label":"Nugget C0","name":"nugget"},{"choices":["Spherical","Exponential","Gaussian","Power"],"default":"Spherical","kind":"choice","label":"Structure 1 · model","name":"s1_model"},{"default":1.0,"kind":"number","label":"Structure 1 · sill/contribution C","name":"s1_sill"},{"default":0.0,"kind":"number","label":"Structure 1 · correlation range a (0=auto)","name":"s1_range"},{"default":0.0,"kind":"number","label":"Structure 1 · azimuth, °","name":"s1_azimuth"},{"default":1.0,"kind":"number","label":"Structure 1 · anisotropy (minor/major)","name":"s1_anis"},{"default":0.0,"kind":"number","label":"Outliers: clip percentile, % (0 = off)","name":"val_pct"},{"kind":"number","label":"Lower value bound (empty = none)","name":"val_min"},{"kind":"number","label":"Upper value bound (empty = none)","name":"val_max"},{"default":false,"kind":"bool","label":"Cap to bound (capping) instead of removing","name":"val_cap"},{"help":"The minimum curvature grid covers the extent of the features of this layer.","kind":"vectorLayer","label":"Min. curvature: layer whose extent the grid covers (empty = by the points)","name":"extent"},{"default":0.0,"kind":"number","label":"Min curvature: cell size (0 = auto)","name":"cell_size"},{"default":0.0,"kind":"number","label":"Min curvature: tension (0..1)","name":"tension"},{"help":"Only points within the extent of the features of this layer are validated.","kind":"vectorLayer","label":"Validate only within the extent of a layer (empty = everywhere)","name":"filter_extent"},{"kind":"number","label":"Validate where Z is at least (empty = none)","name":"zmin"},{"kind":"number","label":"Validate where Z is at most (empty = none)","name":"zmax"},{"default":0,"kind":"number","label":"RNG seed (0 = random)","name":"seed"}],"summary":"Leave-one-out cross-validation for a gridding method - kriging or minimum curvature.","toolbox":"Isoliner"},
    {"id":"minkowski-dimension","name":"7.04 Minkowski dimension (vectors)","params":[{"kind":"vectorLayer","label":"Lines or polygons","name":"features","required":true},{"default":8,"kind":"number","label":"Number of grid sizes (K)","name":"n_sizes"},{"default":3,"kind":"number","label":"Grid offsets per size","name":"offsets"},{"default":0.5,"kind":"number","label":"Sampling densify factor (0 = vertices)","name":"densify"}],"summary":"Box-counting directly over vectors: lines and polygon boundaries are covered by a grid of a decreasing size, the slope of log N versus log(1/size) gives the Minkowski dimension.","toolbox":"Isoliner"},
    {"id":"contoursplit","name":"2.08 Split contours for validation","params":[{"kind":"vectorLayer","label":"Contours (lines)","name":"input","required":true},{"kind":"numericField","label":"Elevation field","name":"field"},{"default":4,"kind":"number","label":"Hold out every Nth elevation","name":"every"},{"default":0,"kind":"number","label":"Selection offset","name":"offset"}],"summary":"Splits the contours into two sets: one is used to build the relief, the other to check the result.","toolbox":"Isoliner"}
  ],
